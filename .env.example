# Copy to .env and fill in. Never commit real values.

BJVI_DATABASE_PATH=bjvi_handoff.db
BJVI_OPERATOR_TOKEN=
BJVI_STALE_THRESHOLD_SECONDS=1800
BJVI_SIGNATURE_TOLERANCE_SECONDS=300

# One shared secret per external AI worker: BJVI_WORKER_SECRET_<WORKER>
BJVI_WORKER_SECRET_CLAUDE=
# BJVI_WORKER_SECRET_CODEX=
# BJVI_WORKER_SECRET_DEVIN=

MONDAY_API_TOKEN=
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_STATUS_COLUMN_ID=status

# Either a bot token or an incoming webhook
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#claude-handoff
